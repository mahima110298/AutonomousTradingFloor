# Required: language model provider
OPENAI_API_KEY=sk-...

# Optional: model selection
TF_RESEARCHER_MODEL=gpt-4o-mini
TF_STRATEGIST_MODEL=gpt-4o-mini
TF_RISK_MODEL=gpt-4o-mini
TF_TRADER_MODEL=gpt-4o-mini

# Simulation parameters
TF_STARTING_CASH=1000000
TF_PRICE_SEED=42
TF_DATA_DIR=./runs
TF_MAX_POSITION_PCT=20
TF_MAX_SECTOR_PCT=40
